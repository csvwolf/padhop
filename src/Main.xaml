<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PadHop" Width="1120" Height="790" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#111820" Foreground="#E4ECF3" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style x:Key="ScopeSegment" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#91A3B5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="24,11"/><Setter Property="MinWidth" Value="160"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Segment" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="#293F50"/><Setter Property="Foreground" Value="#E4ECF3"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="#284C63"/><Setter TargetName="Segment" Property="BorderBrush" Value="#4C8CA9"/><Setter Property="Foreground" Value="#7DDAFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="#7DDAFF"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Segment" Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

 <ControlTemplate x:Key="CleanMenu" TargetType="ContextMenu"><Border Background="#1C2B38" BorderBrush="#365063" BorderThickness="1" CornerRadius="6" Padding="5"><StackPanel IsItemsHost="True"/></Border></ControlTemplate>
  <SolidColorBrush x:Key="Muted" Color="#91A3B5"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#E4ECF3"/><Setter Property="Background" Value="#293B4B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#38546B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="14,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="18,14"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE5EE"/><Setter Property="Margin" Value="0,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="17" Height="17" Background="#111D27" BorderBrush="#577084" BorderThickness="1" CornerRadius="3"><Path x:Name="Check" Data="M 3,7 L 6,10 L 12,3" Stroke="White" StrokeThickness="2" Visibility="Hidden" Margin="1"/></Border><ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#167BA8"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#65D5FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,10,0,0"/><Setter Property="Height" Value="22"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="3" Background="#425868" VerticalAlignment="Center" CornerRadius="2"/><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.Thumb><Thumb Width="14" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#62CDFA" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#3C5367" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#8FA6BA"/><Setter Property="Padding" Value="24,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBg" Background="#14202B" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBg" Property="Background" Value="#23394A"/><Setter TargetName="TabBg" Property="BorderBrush" Value="#61CDFA"/><Setter Property="Foreground" Value="#E6F4FC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel><TabPanel IsItemsHost="True" DockPanel.Dock="Top"/><ContentPresenter ContentSource="SelectedContent"/></DockPanel></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E4ECF3"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBg" Background="#1C2C39" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="#365B74"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E4ECF3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#243646" BorderBrush="#426076" BorderThickness="1" CornerRadius="4" Padding="10"><Grid><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="#8FBBCE"/><ContentPresenter TextElement.Foreground="#E4ECF3" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="0,0,24,0"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#1C2C39" BorderBrush="#426076" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#E4ECF3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ItemBg" Background="Transparent" Padding="14,9"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="#30526B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1B2733"/><Setter Property="BorderBrush" Value="#2B3B4A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,7,0,0"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0D131B" BorderBrush="#263441" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="25,32,16,30"><Image x:Name="BrandIcon" Width="48" Height="48" HorizontalAlignment="Left"/><TextBlock Text="PadHop" FontSize="28" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBlock Text="CONTROLLER UTILITY" FontSize="10" Foreground="#6E9BB7"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="25,24"><TextBlock Text="SC2 / DESKTOP" FontSize="10" Foreground="#688097"/><TextBlock Text="实验版 · 0.2.0" Style="{StaticResource Caption}"/><TextBlock Text="关闭窗口后留在托盘" Style="{StaticResource Caption}"/></StackPanel>
    <StackPanel><Button x:Name="NavDesktop" Style="{StaticResource Nav}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="◈" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="接管状态" VerticalAlignment="Center" TextWrapping="NoWrap"/></Grid></Button><Button x:Name="NavTouch" Style="{StaticResource Nav}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="≋" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="手柄输入设置" VerticalAlignment="Center" TextWrapping="NoWrap"/></Grid></Button><Button x:Name="NavRules" Style="{StaticResource Nav}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▤" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="应用规则" VerticalAlignment="Center" TextWrapping="NoWrap"/></Grid></Button><Button x:Name="NavApps" Style="{StaticResource Nav}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▦" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="应用配置" VerticalAlignment="Center" TextWrapping="NoWrap"/></Grid></Button><Button x:Name="NavAbout" Style="{StaticResource Nav}" Content="ⓘ    关于"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="34,28,34,20">
   <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="接管状态" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="让 Steam Controller 2，在更多地方好用。" Style="{StaticResource Caption}"/></StackPanel><Border Background="#1F3040" CornerRadius="14" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,7"><TextBlock x:Name="RunBadge" Text="●  已暂停" Foreground="#9DB1C3" FontSize="12"/></Border></Grid>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,16,10,0">
     <StackPanel x:Name="AboutPage" Visibility="Collapsed"/><StackPanel x:Name="DesktopPage">
      <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="让 SC2 随处可用" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="统一接管左右触摸板：左右板按各自配置运行。" Style="{StaticResource Caption}"/><TextBlock x:Name="CapabilityHint" Text="标准版支持普通窗口；操作提权应用需要签名 UIAccess 版。" Style="{StaticResource Caption}"/></StackPanel><Button x:Name="ToggleRun" Grid.Column="1" Content="启用接管" Background="#167BA8" VerticalAlignment="Center"/></Grid></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="左右触摸板 · 统一接管" FontSize="16" FontWeight="SemiBold"/><Grid Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="左触摸板" Foreground="#64CBF4"/><TextBlock Text="默认滚动 · 按压右键" Style="{StaticResource Caption}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="右触摸板" Foreground="#64CBF4"/><TextBlock Text="默认移动 · 按压左键" Style="{StaticResource Caption}"/></StackPanel></Grid><Border Background="#17222C" Padding="12" CornerRadius="4"><TextBlock Text="Steam 提示：如果 Steam 的桌面绑定仍在输出，可能出现重复移动或滚动。建议在 Steam 中关闭对应绑定；此提示不阻止启用，也不会自动修改 Steam。" Foreground="#9FB3C4" FontSize="12"/></Border></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="TouchPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="移动与惯性" FontSize="16" FontWeight="SemiBold"/><Grid Margin="0,20,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><DockPanel><TextBlock Text="移动速度"/><TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#60CCFF"/></DockPanel><Slider x:Name="Speed" Minimum="0.05" Maximum="5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/><TextBlock Text="保留细小移动，同时兼顾跨屏距离。" Style="{StaticResource Caption}"/></StackPanel><StackPanel Grid.Column="2"><DockPanel><TextBlock Text="平滑"/><TextBlock x:Name="SmoothValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#60CCFF"/></DockPanel><Slider x:Name="Smooth" Minimum="0" Maximum="100" Value="12" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Text="降低抖动；数值越高，跟随越柔和。" Style="{StaticResource Caption}"/></StackPanel></Grid><CheckBox x:Name="Inertia" Content="轨迹球惯性 · 抬手后继续滑行，重新触摸刹车" IsChecked="True"/><DockPanel><TextBlock Text="惯性摩擦"/><TextBlock x:Name="FrictionValue" HorizontalAlignment="Right" Foreground="#60CCFF"/></DockPanel><Slider x:Name="Friction" Minimum="1" Maximum="30" Value="8" TickFrequency="1" IsSnapToTickEnabled="True"/></StackPanel></Border>

      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="触觉 · 录入与微调" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="录下 Steam 的触觉指令，选中喜欢的一种，再微调。" Style="{StaticResource Caption}"/><Border Background="#13232F" CornerRadius="5" Padding="18" Margin="0,20,0,18"><StackPanel><TextBlock Text="已验证的左板滑动脉冲" Foreground="#6FD5FC"/><TextBlock Text="400 μs   /   0 μs   /   1 次" FontSize="25" FontFamily="Consolas" Margin="0,10,0,0"/><TextBlock Text="通电时长                  间隔                 重复" Style="{StaticResource Caption}"/></StackPanel></Border><Button x:Name="OpenLab" Content="打开录制与微调" HorizontalAlignment="Left" Background="#167BA8"/><TextBlock Text="当前录制左板、应用到右板，在独立体验窗口验证。双向录制与应用将接入这里。" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="我的触觉配置" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="HapticSummary" Text="还没有导入配置。" Margin="0,14,0,16" Foreground="#AEBECD"/><StackPanel Orientation="Horizontal"><Button x:Name="ImportHaptic" Content="导入已保存配置"/><Button x:Name="OpenProfileFolder" Content="打开配置文件夹" Margin="12,0,0,0"/></StackPanel><TextBlock Text="已导入的触觉配置目前用于保存与查看，尚未接入日常桌面输出。此界面启动桌面控制时暂不输出震动。" Style="{StaticResource Caption}"/></StackPanel></Border>
     </StackPanel>

     <StackPanel x:Name="AppsPage" Visibility="Collapsed"/>
     <StackPanel x:Name="RulesPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="在哪里使用PadHop" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="Global" Content="黑名单模式"/><TextBlock Text="黑名单模式默认接管，排除名单中的应用除外；白名单模式仅接管明确加入的应用。Steam 普通窗口遵循应用规则；大屏模式和游戏覆盖层不接管。未明确允许的全屏窗口也会跳过。" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border x:Name="RuleDrop" Style="{StaticResource Card}" AllowDrop="True"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="应用规则" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ImportApps" Content="＋ 导入应用"/></StackPanel></Grid><TabControl x:Name="RuleTabs" Margin="0,18,0,0" Height="46" Background="Transparent" BorderThickness="0"><TabItem Header="接管名单"/><TabItem Header="排除名单"/></TabControl><TextBlock x:Name="RuleHint" Foreground="#91A3B5" Margin="0,10,0,0"/><Border Background="#13202B" BorderBrush="#37546B" BorderThickness="1" CornerRadius="5" Padding="18" Margin="0,18,0,16"><TextBlock Text="拖入程序或快捷方式，加入当前名单；也可以点击“导入应用”。" Foreground="#8CB9D3" HorizontalAlignment="Center"/></Border><ListBox x:Name="RuleList" Background="Transparent" BorderThickness="0" Height="144" Foreground="#E4ECF3" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#294257"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#233849"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid Margin="5,9"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><Image Source="{Binding AppIcon}" Width="26" Height="26"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" MaxWidth="420" HorizontalAlignment="Left" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Path}" FontSize="10" Foreground="#8297AB" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="420" HorizontalAlignment="Left"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="FlipRule" Content="移至另一个名单"/><Button x:Name="RemoveRule" Content="移除所选" Margin="10,0,0,0"/><Button x:Name="ImportFolder" Content="排除整个文件夹" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
      <TextBlock Text="Steam 普通窗口按此处规则接管；大屏模式和游戏覆盖层始终交还 Steam。添加相同程序会更新现有规则，不会创建冲突条目。" Style="{StaticResource Caption}"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <StackPanel Grid.Row="2"><StackPanel x:Name="FullConfigBar" Visibility="Collapsed"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock x:Name="Footer" Text="设置已就绪 · F12 可紧急停止桌面控制" Foreground="#859BAF" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="Save" Grid.Column="1" Content="保存设置" VerticalAlignment="Center"/></Grid></StackPanel>
  </Grid>
 </Grid>
</Window>
